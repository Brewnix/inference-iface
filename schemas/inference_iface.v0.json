{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fyberlabs.com/schemas/fyber.inference_iface/v0",
  "title": "Fyber inference interface envelope v0",
  "description": "Model/rules output: judgment + typed proposals only. LLM never executes. LOCKED 2026-09-06.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "trace_id",
    "site_id",
    "actor",
    "observed_at",
    "inputs_digest",
    "judgment",
    "proposals",
    "confidence",
    "needs_human"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "fyber.inference_iface/v0"
    },
    "trace_id": {
      "$ref": "https://fyberlabs.com/schemas/fyber.common/v0#/$defs/Uuid"
    },
    "site_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "actor": {
      "$ref": "https://fyberlabs.com/schemas/fyber.common/v0#/$defs/Actor"
    },
    "observed_at": {
      "$ref": "https://fyberlabs.com/schemas/fyber.common/v0#/$defs/Rfc3339"
    },
    "inputs_digest": {
      "$ref": "https://fyberlabs.com/schemas/fyber.common/v0#/$defs/Sha256Digest",
      "description": "Digest of the redacted feature bundle (canonical JSON)."
    },
    "judgment": {
      "$ref": "https://fyberlabs.com/schemas/fyber.common/v0#/$defs/SeverityJudgment"
    },
    "proposals": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "https://fyberlabs.com/schemas/fyber.common/v0#/$defs/ToolCall"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "needs_human": { "type": "boolean" },
    "notes": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional; never required for act."
    }
  }
}
